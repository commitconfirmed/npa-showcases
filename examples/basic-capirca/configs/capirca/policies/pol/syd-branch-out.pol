header {
  comment:: "Sydney Branch Capirca outbound filter example"
  target:: juniper syd-branch-outbound inet
  target:: arista syd-branch-outbound extended
}

#include 'includes/deny-src-reserved.inc'

term permit-ipsec-access {
  comment:: "ENG-2001"
  source-address:: SYD_WAN
  destination-address:: VPN_HUB
  protocol:: 50
  action:: accept
}
term permit-ike-access {
  comment:: "ENG-2001"
  source-address:: SYD_WAN
  destination-address:: VPN_HUB
  protocol:: udp
  destination-port:: IKE IPSEC
  action:: accept
}

#include 'includes/branch-out.inc'