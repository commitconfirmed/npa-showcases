{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Initial Setup Script",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases && bash setup.sh",
        },
        {
            "label": "Import uploaded cRPD and cEOS images",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases/images && bash import-crpd-ceos.sh",
        },
        {
            "label": "basic-nornir: Build Lab",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases/examples/basic-nornir && bash manage.sh build",
        },
        {
            "label": "basic-nornir: Run Lab",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases/examples/basic-nornir && bash manage.sh run",
        },
        {
            "label": "basic-nornir: Stop Lab",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases/examples/basic-nornir && bash manage.sh stop",
        },
        {
            "label": "basic-ansible: Build Lab",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases/examples/basic-ansible && bash manage.sh build",
        },
        {
            "label": "basic-ansible: Run Lab",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases/examples/basic-ansible && bash manage.sh run",
        },
        {
            "label": "basic-ansible: Stop Lab",
            "type": "shell",
            "command": "cd /workspaces/npa-showcases/examples/basic-ansible && bash manage.sh stop",
        },
    ]
}